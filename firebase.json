{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   ".firebaserc",
   "**/.*",
   "**/node_modules/**",
   "README.md",
   "tests/**",
   ".gitignore"
  ],
  "cleanUrls": true,
  "headers": [
   {
    "source": "**",
    "headers": [
     {
      "key": "X-Content-Type-Options",
      "value": "nosniff"
     },
     {
      "key": "X-Frame-Options",
      "value": "DENY"
     },
     {
      "key": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
     },
     {
      "key": "Permissions-Policy",
      "value": "camera=(), microphone=(), geolocation=(), payment=()"
     },
     {
      "key": "Strict-Transport-Security",
      "value": "max-age=31536000; includeSubDomains"
     },
     {
      "key": "Content-Security-Policy",
      "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://www.gstatic.com; frame-src https://bogs-pedidos.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
     }
    ]
   },
   {
    "source": "**/*.@(jpg|png)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public,max-age=31536000,immutable"
     }
    ]
   },
   {
    "source": "index.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "sw.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "data.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules",
  "indexes": "firestore.indexes.json"
 }
}