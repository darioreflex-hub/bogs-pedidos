{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   ".firebaserc",
   "**/.*",
   "**/node_modules/**",
   "README.md"
  ],
  "cleanUrls": true,
  "headers": [
   {
    "source": "**/*.@(jpg|png)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public,max-age=31536000,immutable"
     }
    ]
   },
   {
    "source": "index.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "sw.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "data.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules",
  "indexes": "firestore.indexes.json"
 }
}