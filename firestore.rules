rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Admin: el dueño con Gmail verificado, un email verificado listado en admins/{email},
    // o cualquier cuenta cuyo ID de usuario esté en admins/{uid} (sirve para usuarios sin correo real).
    function verifiedEmail() { return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function isAdmin() {
      return request.auth != null && (
        (verifiedEmail() && request.auth.token.email == 'darioreflex@gmail.com') ||
        (verifiedEmail() && exists(/databases/$(db)/documents/admins/$(request.auth.token.email))) ||
        exists(/databases/$(db)/documents/admins/$(request.auth.uid))
      );
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function validOrder(o) {
      return o.status == 'nuevo'
        && str(o.code, 16)
        && o.items is list && o.items.size() > 0 && o.items.size() <= 40
        && o.total is number && o.total > 0 && o.total < 5000000
        && o.subtotal is number && o.ship is number && o.discount is number
        && o.mode in ['delivery', 'retiro']
        && o.pay in ['mp', 'transfer', 'cash']
        && str(o.note, 500)
        && o.customer is map
        && str(o.customer.name, 80) && o.customer.name.size() > 0
        && str(o.customer.phone, 30)
        && str(o.customer.addr, 160) && str(o.customer.city, 60)
        && str(o.customer.floor, 60) && str(o.customer.instr, 200)
        && o.createdAt == request.time;
    }
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /menu/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /admins/{key}   { allow read, write: if isAdmin(); }
    match /coupons/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) && request.resource.data.uses == resource.data.uses + 1);
    }
    match /club/{phone} { allow get: if true; allow list, write: if isAdmin(); }
    match /errors/{id} {
      allow create: if str(request.resource.data.msg, 500) && str(request.resource.data.src, 300) && str(request.resource.data.ua, 300) && str(request.resource.data.app, 20) && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }
    match /orders/{id} {
      allow get: if true;
      allow create: if validOrder(request.resource.data);
      allow list, update, delete: if isAdmin();
    }
  }
}
