rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'darioreflex@gmail.com' ||
        exists(/databases/$(db)/documents/admins/$(request.auth.token.email))
      );
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function validOrder(o) {
      return o.status == 'nuevo'
        && str(o.code, 16)
        && o.items is list && o.items.size() > 0 && o.items.size() <= 40
        && o.total is number && o.total > 0 && o.total < 5000000
        && o.subtotal is number && o.ship is number && o.discount is number
        && o.mode in ['delivery', 'retiro']
        && o.pay in ['mp', 'transfer', 'cash']
        && str(o.note, 500)
        && o.customer is map
        && str(o.customer.name, 80) && o.customer.name.size() > 0
        && str(o.customer.phone, 30)
        && str(o.customer.addr, 160) && str(o.customer.city, 60)
        && str(o.customer.floor, 60) && str(o.customer.instr, 200)
        && o.createdAt == request.time;
    }
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /menu/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /admins/{email} { allow read, write: if isAdmin(); }
    match /orders/{id} {
      allow get: if true;
      allow create: if validOrder(request.resource.data);
      allow list, update, delete: if isAdmin();
    }
  }
}
